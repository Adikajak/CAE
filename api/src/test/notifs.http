@baseUrl = http://localhost:3000

### Get all notifications for authenticated user
GET {{baseUrl}}/notifications/
Authorization: {{token}}

###

### Get a single notification by ID
GET {{baseUrl}}/notifications/1
Authorization: {{token}}

###

### Mark a notification as read
POST {{baseUrl}}/notifications/1/read
Authorization: {{token}}

###

### Create a notification
POST {{baseUrl}}/notifications/
Authorization: {{token}}
Content-Type: application/json

{
  "userId": 1,
  "object": "Test notification",
  "message": "This is a test notification message",
  "type": "GENERAL"
}

###

### Create a team invitation notification
POST {{baseUrl}}/notifications/
Authorization: {{token}}
Content-Type: application/json

{
  "userId": 1,
  "object": "Invitation à rejoindre une équipe",
  "message": "Vous avez été invité à rejoindre une équipe",
  "type": "TEAM_INVITATION",
  "membershipId": 1
}