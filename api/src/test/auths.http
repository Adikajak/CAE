@baseUrl = http://localhost:3000

### Try to login an unknown user with an unvalid field (email must contain {value}@{value}.{value} like value)
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email":"unknown",
  "password":"admin"
}

### Try to register an unknown user with an unvalid field (email must contain {value}@{value}.{value} like value)
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "email":"unknown",
  "password":"admin"
}

### Try to login an unknown user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email":"unknown@unknown.com",
  "password":"admin"
}

### Create the default admin
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "email":"admin@admin.com",
  "password":"admin"
}

### Login the default admin
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email":"admin@admin.com",
  "password":"admin"
}


### Create the manager user
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "email":"manager@manager.com",
  "password":"manager"
}

### Login the manager user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email":"manager@manager.com",
  "password":"manager"
}